<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <title>Predictor Futebol</title>
</head>
<body class="bg-dark text-white p-3">
    <div class="container bg-secondary rounded p-3 shadow">
        <h2 class="text-center">📊 Analisador: <%= teamName %></h2>
        <hr>
        <h5>Últimos 5 Jogos:</h5>
        <div class="table-responsive">
            <table class="table table-dark table-sm">
                <thead><tr><th>Data</th><th>Cantos</th><th>Imp.</th><th>Cart.</th></tr></thead>
                <tbody>
                    <% games.forEach(g => { %>
                        <tr><td><%= g.date %></td><td><%= g.corners %></td><td><%= g.offsides %></td><td><%= g.cards %></td></tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
        <div class="mt-4 p-3 bg-primary rounded text-center">
            <h4>🔮 Previsão Próximo Jogo</h4>
            <p>Mais de 8.5 Cantos: <strong><%= predictions.moreThan8Corners %>%</strong></p>
            <p>Mais de 3.5 Cartões: <strong><%= predictions.moreThan3Cards %>%</strong></p>
        </div>
    </div>
</body>
</html>
