<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <title>Predictor Pro</title>
</head>
<body class="bg-dark text-white p-3">
    <div class="container bg-secondary rounded p-4 shadow-lg" style="max-width: 500px;">
        
        <form action="/" method="GET" class="mb-4">
            <label class="form-label">Introduzir ID da Equipa:</label>
            <div class="input-group">
                <input type="number" name="teamId" class="form-control" placeholder="Ex: 33" required>
                <button class="btn btn-warning" type="submit">🔍 Analisar</button>
            </div>
            <small class="text-light opacity-75">Man Utd: 33 | Real Madrid: 541 | Benfica: 211</small>
        </form>

        <h2 class="text-center mb-0">📊 <%= teamName %></h2>
        <hr class="border-light">

        <h6 class="mb-3">Últimos 5 Jogos:</h6>
        <div class="table-responsive">
            <table class="table table-dark table-striped table-sm text-center">
                <thead>
                    <tr>
                        <th>Data</th>
                        <th>Cantos</th>
                        <th>Imp.</th>
                        <th>Cart.</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (games && games.length > 0) { %>
                        <% games.forEach(g => { %>
                            <tr>
                                <td><%= g.date %></td>
                                <td><%= g.corners %></td>
                                <td><%= g.offsides %></td>
                                <td><%= g.cards %></td>
                            </tr>
                        <% }) %>
                    <% } else { %>
                        <tr><td colspan="4">Sem dados disponíveis</td></tr>
                    <% } %>
                </tbody>
            </table>
        </div>

        <div class="mt-4 p-3 bg-primary rounded shadow">
            <h5 class="text-center border-bottom pb-2">🔮 Previsão Próximo Jogo</h5>
            <div class="d-flex justify-content-between mt-2">
                <span>Mais de 8.5 Cantos:</span>
                <span class="badge bg-light text-dark fs-6"><%= predictions.moreThan8Corners %>%</span>
            </div>
            <div class="d-flex justify-content-between mt-2">
                <span>Mais de 3.5 Cartões:</span>
                <span class="badge bg-light text-dark fs-6"><%= predictions.moreThan3Cards %>%</span>
            </div>
        </div>
    </div>
</body>
</html>

